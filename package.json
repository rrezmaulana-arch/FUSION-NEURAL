{
  "name": "fusion-neural",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:ui": "cd frontend && vite",
    "dev:backend": "cd backend && venv\\Scripts\\activate && python main.py",
    "dev:ngrok": "ngrok http --url=confined-simple-handiwork.ngrok-free.dev 8001",
    "dev": "concurrently -c \"cyan.bold,green.bold\" -n \"UI,BACKEND\" \"npm run dev:ui\" \"npm run dev:backend\"",
    "dev:with-ngrok": "concurrently -c \"cyan.bold,green.bold,magenta.bold\" -n \"UI,BACKEND,NGROK\" \"npm run dev:ui\" \"npm run dev:backend\" \"npm run dev:ngrok\"",
    "build": "cd frontend && tsc -b && vite build",
    "lint": "cd frontend && eslint src",
    "preview": "cd frontend && vite preview"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@types/three": "^0.184.0",
    "docx": "^9.7.1",
    "firebase": "^12.12.1",
    "framer-motion": "^12.38.0",
    "groq-sdk": "^1.1.2",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.23",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "three": "^0.184.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ngrok/ngrok": "^1.7.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.7.13",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
