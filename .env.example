# ── FUSION NEURAL — Environment Variables Example ────────────────────────────
# Salin file ini menjadi '.env' dan isi dengan nilai asli Anda.
# JANGAN PERNAH commit file '.env' ke Git!
# File ini (.env.example) aman untuk di-push ke repository.

# ── Firebase (Client SDK — aman untuk publik) ────────────────────────────────
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abc123"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ── Firebase Backend Auth (digunakan hanya di server Python) ─────────────────
FIREBASE_BACKEND_EMAIL="backend-agent@yourdomain.app"
FIREBASE_BACKEND_PASS="YourStrongPassword2026!"

# ── AI Providers (RAHASIA — jangan pernah gunakan prefix VITE_ di sini!) ────
GROQ_API_KEY="gsk_..."
GEMINI_API_KEY="AIzaSy..."
OPENROUTER_API_KEY="sk-or-v1-..."
CEREBRAS_API_KEY="csk-..."
MISTRAL_API_KEY="your-mistral-key"
DEEPSEEK_API_KEY="sk-..."
COHERE_API_KEY="your-cohere-key"
HF_TOKEN="hf_..."

# ── Search API ───────────────────────────────────────────────────────────────
SERPER_API_KEY="your-serper-key"

# ── Memory (Upstash Redis) ───────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ── Payment Gateway (Midtrans) ───────────────────────────────────────────────
MIDTRANS_SERVER_KEY="Mid-server-..."        # RAHASIA — backend only
MIDTRANS_ENV="sandbox"
VITE_MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com/snap/snap.js"
VITE_MIDTRANS_CLIENT_KEY="Mid-client-..."  # Publik — aman untuk VITE_

# ── Messaging (Twilio WhatsApp) ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"

# ── Social Media (Instagram API) ─────────────────────────────────────────────
INSTAGRAM_APP_ID="your-app-id"
INSTAGRAM_APP_SECRET="your-app-secret"
INSTAGRAM_VERIFY_TOKEN="your-verify-token"
INSTAGRAM_ACCESS_TOKEN="your-long-lived-access-token"
INSTAGRAM_PAGE_ID="your-page-id"

# ── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# ── Google Drive ─────────────────────────────────────────────────────────────
GOOGLE_DRIVE_FOLDER_ID="your-folder-id"

# ── Finance External API ─────────────────────────────────────────────────────
MASSIVE_API_KEY="your-massive-api-key"

# ── Backend URL (Dev Local) ──────────────────────────────────────────────────
PYTHON_BACKEND_URL="http://localhost:8001"
VITE_API_URL="http://localhost:8001"
# Public URL untuk media files — ganti dengan domain production saat deploy
BACKEND_PUBLIC_URL="http://localhost:8001"

# Imgbb — Upload gambar gratis unlimited (daftar: https://api.imgbb.com)
VITE_IMGBB_API_KEY="your_imgbb_api_key_here"
