// ─────────────────────────────────────────────────────────────────────────────
// FusionNeural — Firebase Security Rules v2.0
//
// Arsitektur Auth:
//   - Frontend (React): Firebase JWT token dari logged-in user
//   - Backend (Python): Firebase email/password auth (backend-agent@fusionneural.app)
//   - Semua write memerlukan request.auth != null → isAuthenticated()
// ─────────────────────────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper ───────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }
    function isRole(rolePrefix) {
      return isAuthenticated() && request.auth.token.email.matches('^' + rolePrefix + '@.*');
    }
    function isManager() {
      return isRole('manager') || isRole('backend-agent');
    }

    // ── AI Orchestrator & Agent Collections ──────────────────────────────────
    // Backend Python (backend-agent@fusionneural.app) menulis ke sini.
    match /neural_tasks/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /ai_tickets/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /pending_approvals/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /realtime_signals/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /run_transcripts/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /agent_health/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /system_config/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /agent_budgets/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /agent_schedules/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /system_prompts/{docId} {
      allow read, write: if isAuthenticated();
    }

    // ── Business Data (read only for clients, backend can write) ─────────────
    match /inventory/{docId} {
      allow read: if isManager() || isRole('admin');
      allow write: if isManager() || isRole('admin');
    }
    match /orders/{docId} {
      allow read: if isManager() || isRole('admin') || isRole('finance');
      allow write: if isManager() || isRole('admin');
    }
    match /financial_reports/{docId} {
      allow read: if isManager() || isRole('finance');
      allow write: if isManager() || isRole('finance');
    }
    match /finance_metrics/{docId} {
      allow read: if isManager() || isRole('finance');
      allow write: if isManager() || isRole('finance');
    }
    match /market_simulator/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /signals/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /activity_logs/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
    match /neural_configs/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /marketing_assets/{docId} {
      allow read, write: if isManager() || isRole('marketing');
    }

    // ── User Profiles ─────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ── Fallback: block unauthenticated access, allow authenticated ───────────
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
