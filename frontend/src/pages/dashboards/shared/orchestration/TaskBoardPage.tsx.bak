import { useState, useEffect } from 'react';
import { Plus, GripHorizontal, MessageSquare, Bot } from 'lucide-react';
import { db } from '../../../../lib/firebase';
import { collection, onSnapshot, query, addDoc } from 'firebase/firestore';
import PageHeader from '../../../../components/ui/PageHeader'; export default function TaskBoardPage() { const columns = ['Backlog', 'To Do', 'In Progress', 'Review', 'Done']; const [tasks, setTasks] = useState<any[]>([]); useEffect(() => { const q = query(collection(db, 'ai_tickets')); const unsub = onSnapshot(q, (snap) => { const loaded = snap.docs.map(doc => ({ id: doc.id, ...doc.data() })); setTasks(loaded); }); return () => unsub(); }, []); const handleNewTask = async () => { const title = prompt("Enter new task objective for AI:"); if (!title) return; const agent = prompt("Assign to which agent? (e.g. Neural Marketing, Neural Finance)", "Neural Marketing"); if (!agent) return; await addDoc(collection(db, 'ai_tickets'), { title, agent, status: 'To Do', comments: 0, createdAt: new Date().toISOString() }); }; return ( <div className="space-y-6 pb-10 h-[calc(100vh-6rem)] flex flex-col"> <PageHeader title="Agent Task Board" subtitle="Kanban board for orchestrating autonomous AI agent issues" accent="indigo" /> <div className="flex-1 flex gap-4 overflow-x-auto pb-4 no-scrollbar"> {columns.map(col => ( <div key={col} className="min-w-[300px] w-[300px] flex flex-col bg-black/20/50 rounded-2xl border border-white/20"> <div className="p-4 border-b border-white/20/60 flex items-center justify-between"> <h3 className="font-bold text-slate-200 text-sm">{col}</h3> <span className="bg-slate-200 text-slate-300 text-xs px-2 py-0.5 rounded-full font-bold"> {tasks.filter(t => t.status === col).length} </span> </div> <div className="flex-1 p-3 space-y-3 overflow-y-auto"> {tasks.filter(t => t.status === col).map(task => ( <div key={task.id} className="bg-white/[0.03] backdrop-blur-xl border-white/10 text-slate-100 p-4 rounded-xl shadow-sm hover:shadow-md transition-shadow cursor-pointer group"> <div className="flex items-center justify-between mb-2"> <span className="text-[10px] font-mono text-slate-400 bg-slate-100 px-1.5 py-0.5 rounded">{task.id}</span> <GripHorizontal size={14} className="text-slate-300 opacity-0 group-hover:opacity-100 transition-opacity" /> </div> <h4 className="font-bold text-slate-100 text-sm mb-3 leading-snug">{task.title}</h4> <div className="flex items-center justify-between pt-3 border-t border-white/10"> <div className="flex items-center gap-1.5 bg-indigo-50 text-indigo-600 px-2 py-1 rounded-md text-xs font-bold w-max"> <Bot size={12} /> {task.agent} </div> {task.comments > 0 && ( <div className="flex items-center gap-1 text-slate-400 text-xs"> <MessageSquare size={12} /> {task.comments} </div> )} </div> </div> ))} {col === 'To Do' && ( <button onClick={handleNewTask} className="w-full py-3 flex items-center justify-center gap-2 text-slate-400 border-2 border-dashed border-white/20 rounded-xl hover:text-indigo-500 hover:border-indigo-200 hover:bg-indigo-50/50 transition-colors"> <Plus size={16} /> <span className="text-sm font-bold">New Task</span> </button> )} </div> </div> ))} </div> </div> );
}
