import { useState, useEffect } from 'react';
import { motion } from 'framer-motion';
import { Target, Filter } from 'lucide-react';
import { db } from '../../../lib/firebase';
import { collection, query, orderBy, limit, onSnapshot } from 'firebase/firestore';
import PageHeader from '../../../components/ui/PageHeader';
import { LineChart, Line, XAxis, YAxis, Tooltip, ResponsiveContainer, CartesianGrid } from 'recharts'; export default function MarketingAnalyticsPage() { const [timeframe, setTimeframe] = useState('7d'); const [funnel, setFunnel] = useState({ impressions: 125000, clicks: 5250, add_to_cart: 840, purchases: 110 }); const [campaigns, setCampaigns] = useState<any[]>([]); useEffect(() => { const q = query(collection(db, 'marketing_stats'), orderBy('timestamp', 'desc'), limit(100)); const unsub = onSnapshot(q, (snap) => { let imp = 125000, clk = 5250, atc = 840, pur = 110; const camps: Record<string, any> = {}; snap.docs.forEach(d => { const data = d.data(); imp += data.impressions || 0; clk += data.clicks || 0; atc += data.add_to_cart || 0; pur += data.purchases || 0; const cName = data.campaign || 'Unknown Campaign'; if (!camps[cName]) camps[cName] = { name: cName, plat: cName.split(' ')[2] || 'Meta Ads', spend: 0, rev: 0 }; camps[cName].spend += (data.clicks || 0) * 1500; // mock spend calc camps[cName].rev += (data.purchases || 0) * 125000; // mock rev calc }); setFunnel({ impressions: imp, clicks: clk, add_to_cart: atc, purchases: pur }); const campArray = Object.values(camps).map(c => { const roas = c.spend > 0 ? (c.rev / c.spend).toFixed(1) : '0.0'; return { name: c.name, plat: c.plat, spend: `Rp ${(c.spend/1000000).toFixed(1)}M`, rev: `Rp ${(c.rev/1000000).toFixed(1)}M`, roas: `${roas}x` }; }).sort((a,b) => parseFloat(b.roas) - parseFloat(a.roas)).slice(0, 5); if (campArray.length > 0) setCampaigns(campArray); }); return () => unsub(); }, []); const metrics = [ { label: 'Return on Ad Spend (ROAS)', value: ((funnel.purchases * 125000) / (funnel.clicks * 1500)).toFixed(1) + 'x', trend: '+12%', color: 'emerald' }, { label: 'Customer Acquisition Cost', value: `Rp ${Math.floor((funnel.clicks * 1500) / funnel.purchases).toLocaleString('id-ID')}`, trend: '-5%', color: 'blue' }, { label: 'Avg. Click-Through Rate', value: ((funnel.clicks / funnel.impressions) * 100).toFixed(1) + '%', trend: '+0.8%', color: 'purple' }, { label: 'Conversion Rate', value: ((funnel.purchases / funnel.clicks) * 100).toFixed(1) + '%', trend: '+0.2%', color: 'rose' } ]; return ( <div className="space-y-6 pb-10"> <PageHeader title="Performance Analytics" subtitle="Pantau efektivitas kampanye, ROAS, dan metrik konversi (Marketing Funnel)." accent="purple" actions={ <div className="flex bg-white/[0.03] backdrop-blur-xl border-white/10 text-slate-100 rounded-xl p-1 border shadow-sm"> {['24h', '7d', '30d'].map(t => ( <button key={t} onClick={() => setTimeframe(t)} className={`px-4 py-1.5 text-xs font-bold rounded-lg transition-colors ${timeframe === t ? 'bg-purple-50 text-purple-600' : 'text-slate-400 hover:text-slate-300'}`} > {t.toUpperCase()} </button> ))} </div> } /> {/* Top Metrics */} <div className="grid grid-cols-2 lg:grid-cols-4 gap-4"> {metrics.map((m, i) => ( <motion.div key={i} initial={{ opacity: 0, y: 15 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: i * 0.1 }} className={`bg-white rounded-2xl p-5 border border-white/10 shadow-sm border-t-4 border-t-${m.color}-500 relative overflow-hidden`} > <div className={`absolute -right-4 -top-4 w-16 h-16 bg-${m.color}-50 rounded-full blur-xl`} /> <p className="text-xs font-bold text-slate-300 mb-1">{m.label}</p> <h3 className="text-2xl font-black text-slate-100">{m.value}</h3> <p className={`text-[10px] font-bold mt-2 ${m.trend.startsWith('+') ? 'text-emerald-500' : 'text-emerald-500'}`}>{m.trend} vs periode lalu</p> </motion.div> ))} </div> {/* Campaign Trend Chart */} <div className="bg-white/[0.03] backdrop-blur-xl rounded-2xl p-6 border border-white/10 shadow-sm mb-6"> <h3 className="text-sm font-bold text-slate-100 mb-4 flex items-center gap-2"> <Target size={16} className="text-purple-500" /> Campaign Performance Trend (Daily Clicks vs Purchases) </h3> <div className="h-64 w-full"> <ResponsiveContainer width="100%" height="100%"> <LineChart data={[ { date: 'Day 1', clicks: 800, purchases: 15 }, { date: 'Day 2', clicks: 950, purchases: 20 }, { date: 'Day 3', clicks: 1200, purchases: 35 }, { date: 'Day 4', clicks: 1100, purchases: 25 }, { date: 'Day 5', clicks: 1500, purchases: 50 }, { date: 'Day 6', clicks: 2100, purchases: 80 }, { date: 'Day 7', clicks: 2800, purchases: 110 } ]} margin={{ top: 5, right: 20, bottom: 5, left: 0 }} > <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="#f1f5f9" /> <XAxis dataKey="date" axisLine={false} tickLine={false} tick={{ fontSize: 10, fill: '#64748b' }} /> <YAxis yAxisId="left" orientation="left" stroke="#a855f7" axisLine={false} tickLine={false} tick={{ fontSize: 10 }} /> <YAxis yAxisId="right" orientation="right" stroke="#ec4899" axisLine={false} tickLine={false} tick={{ fontSize: 10 }} /> <Tooltip cursor={{ stroke: '#cbd5e1', strokeWidth: 1, strokeDasharray: '4 4' }} contentStyle={{ borderRadius: '12px', border: 'none', boxShadow: '0 4px 20px rgba(0,0,0,0.08)' }} /> <Line yAxisId="left" type="monotone" dataKey="clicks" stroke="#a855f7" strokeWidth={3} dot={{ r: 4 }} activeDot={{ r: 6 }} name="Clicks" /> <Line yAxisId="right" type="monotone" dataKey="purchases" stroke="#ec4899" strokeWidth={3} dot={{ r: 4 }} activeDot={{ r: 6 }} name="Purchases" /> </LineChart> </ResponsiveContainer> </div> </div> <div className="grid grid-cols-1 lg:grid-cols-3 gap-6"> {/* Sales Funnel */} <div className="lg:col-span-1 bg-white/[0.03] backdrop-blur-xl border-white/10 text-slate-100 rounded-2xl p-6 border shadow-sm"> <div className="flex items-center gap-2 mb-6"> <Filter size={18} className="text-purple-500" /> <h3 className="font-bold text-slate-100">Sales Funnel</h3> </div> <div className="space-y-4"> {[ { step: 'Impressions', count: funnel.impressions.toLocaleString(), pct: 100, color: 'bg-slate-200' }, { step: 'Clicks (Traffic)', count: funnel.clicks.toLocaleString(), pct: Math.round((funnel.clicks/funnel.impressions)*100), color: 'bg-purple-200' }, { step: 'Add to Cart', count: funnel.add_to_cart.toLocaleString(), pct: Math.round((funnel.add_to_cart/funnel.impressions)*100), color: 'bg-purple-400' }, { step: 'Purchases', count: funnel.purchases.toLocaleString(), pct: Math.round((funnel.purchases/funnel.impressions)*100), color: 'bg-purple-600' } ].map((f, i) => ( <div key={i} className="flex flex-col items-center"> <div className="w-full flex justify-between text-[10px] font-bold text-slate-300 mb-1 px-1"> <span>{f.step}</span> <span>{f.count}</span> </div> <div className={`h-8 rounded-lg flex items-center justify-center text-[10px] font-bold text-white transition-all ${f.color}`} style={{ width: `${f.pct}%` }} > {f.pct < 100 && `${f.pct}%`} </div> </div> ))} </div> </div> {/* Top Campaigns */} <div className="lg:col-span-2 bg-white/[0.03] backdrop-blur-xl border-white/10 text-slate-100 rounded-2xl p-6 border shadow-sm"> <div className="flex items-center gap-2 mb-6"> <Target size={18} className="text-purple-500" /> <h3 className="font-bold text-slate-100">Top Performing Campaigns</h3> </div> <div className="overflow-x-auto"> <table className="w-full text-left border-collapse"> <thead> <tr className="border-b border-white/10 text-[10px] font-bold text-slate-300 uppercase"> <th className="pb-3 font-medium">Campaign Name</th> <th className="pb-3 font-medium">Platform</th> <th className="pb-3 font-medium">Spend</th> <th className="pb-3 font-medium">Revenue</th> <th className="pb-3 font-medium">ROAS</th> </tr> </thead> <tbody className="text-sm"> {(campaigns.length > 0 ? campaigns : [ { name: 'Flash Sale Lebaran', plat: 'Instagram Ads', spend: 'Rp 2.5M', rev: 'Rp 15.0M', roas: '6.0x' }, { name: 'Retargeting Cart Abandons', plat: 'Facebook Pixel', spend: 'Rp 800K', rev: 'Rp 4.2M', roas: '5.2x' } ]).map((c: any, i: number) => ( <tr key={i} className="border-b border-slate-50 last:border-0 hover:bg-black/20 transition-colors"> <td className="py-3 font-bold text-slate-100">{c.name}</td> <td className="py-3 text-slate-400 text-xs">{c.plat}</td> <td className="py-3 text-slate-300 font-mono text-xs">{c.spend}</td> <td className="py-3 text-emerald-600 font-mono font-bold text-xs">{c.rev}</td> <td className="py-3"> <span className="px-2 py-1 bg-purple-50 text-purple-600 rounded-md text-[10px] font-bold">{c.roas}</span> </td> </tr> ))} </tbody> </table> </div> </div> </div> </div> );
}
