import { useEffect, useState } from 'react';
import { db } from '../../../lib/firebase';
import { doc, onSnapshot } from 'firebase/firestore';
import { Sparkles, Edit3 } from 'lucide-react'; export default function GenerativeUIPage() { const [htmlContent, setHtmlContent] = useState<string>(''); const [isGenerating, setIsGenerating] = useState(true); useEffect(() => { // Listen to AI-generated UI from Firestore const unsub = onSnapshot(doc(db, 'system_config', 'generative_ui'), (docSnap) => { if (docSnap.exists() && docSnap.data().html) { setHtmlContent(docSnap.data().html); setIsGenerating(false); } else { setHtmlContent('<div class="text-center p-10 text-slate-400">Marketing AI belum membuat Landing Page.</div>'); setIsGenerating(false); } }); return () => unsub(); }, []); return ( <div className="space-y-6 pb-10 font-['Outfit']"> <div className="flex items-center justify-between"> <div> <h1 className="text-3xl font-black text-slate-100 flex items-center gap-3"> <Sparkles className="text-pink-500" /> Generative UI (Self-Coding) </h1> <p className="text-slate-400 mt-1 text-sm">Landing Page yang dirender langsung dari kode buatan Marketing AI.</p> </div> <div className="bg-pink-100 text-pink-600 px-4 py-2 rounded-xl text-xs font-bold border border-pink-200 flex items-center gap-2"> <Edit3 size={14} /> AI-Generated Live </div> </div> <div className="bg-white/[0.03] backdrop-blur-xl border-white/10 text-slate-100 rounded-3xl p-6 border shadow-sm min-h-[400px]"> {isGenerating ? ( <div className="flex flex-col items-center justify-center h-[300px] text-pink-500 gap-4"> <Sparkles className="animate-spin" size={32} /> <p className="text-sm font-bold animate-pulse">Menunggu injeksi kode dari AI...</p> </div> ) : ( <div className="w-full h-full rounded-2xl overflow-hidden generative-container" dangerouslySetInnerHTML={{ __html: htmlContent }} /> )} </div> <div className="bg-slate-900 rounded-xl p-5 border border-slate-800"> <h4 className="text-sm font-bold text-slate-200 mb-1">FRAMEWORK MODE</h4> <p className="text-xs text-slate-400 leading-relaxed"> Ini adalah fitur Generative UI. Jika Manager menginstruksikan Marketing AI untuk merombak kampanye, AI akan mem-bypass programmer manusia dengan menulis kode HTML/Tailwind langsung ke Firestore. Halaman ini akan me-render hasil rancangan AI tersebut secara seketika kepada pengunjung. </p> </div> </div> );
}
